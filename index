<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CricStream Pro | Live Cricket Matches</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <style>
        /* --- CSS Variables & Reset --- */
        :root {
            --bg-main: #0f172a;
            --bg-card: #1e293b;
            --bg-hover: #334155;
            --text-main: #f8fafc;
            --text-muted: #94a3b8;
            --accent: #10b981; /* Emerald Green */
            --accent-hover: #059669;
            --danger: #ef4444; /* Live Red */
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Poppins', sans-serif;
        }

        body {
            background-color: var(--bg-main);
            color: var(--text-main);
            overflow-x: hidden;
        }

        a { text-decoration: none; color: inherit; }
        ul { list-style: none; }

        /* --- Score Ticker --- */
        .score-ticker {
            background-color: #000;
            color: var(--text-main);
            padding: 8px 0;
            font-size: 0.9rem;
            white-space: nowrap;
            overflow: hidden;
            border-bottom: 1px solid #333;
        }
        
        .ticker-content {
            display: inline-block;
            animation: scroll-ticker 20s linear infinite;
        }

        .ticker-item {
            display: inline-block;
            margin-right: 50px;
            font-weight: 600;
        }
        
        .ticker-item span { color: var(--accent); }

        @keyframes scroll-ticker {
            0% { transform: translateX(100%); }
            100% { transform: translateX(-100%); }
        }

        /* --- Navigation --- */
        header {
            background-color: var(--bg-card);
            padding: 15px 5%;
            display: flex;
            justify-content: space-between;
            align-items: center;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.5);
            position: sticky;
            top: 0;
            z-index: 100;
        }

        .logo {
            font-size: 1.8rem;
            font-weight: 700;
            color: var(--text-main);
            display: flex;
            align-items: center;
            gap: 10px;
        }
        
        .logo i { color: var(--accent); }

        .nav-links {
            display: flex;
            gap: 25px;
        }

        .nav-links a {
            font-weight: 600;
            transition: color 0.3s ease;
        }

        .nav-links a:hover { color: var(--accent); }
        .nav-links a.active { color: var(--accent); border-bottom: 2px solid var(--accent); padding-bottom: 5px; }

        .user-actions button {
            background-color: var(--accent);
            color: white;
            border: none;
            padding: 8px 20px;
            border-radius: 20px;
            font-weight: 600;
            cursor: pointer;
            transition: background 0.3s;
        }

        .user-actions button:hover { background-color: var(--accent-hover); }

        /* --- Main Layout --- */
        .main-container {
            display: grid;
            grid-template-columns: 3fr 1fr;
            gap: 20px;
            padding: 20px 5%;
            min-height: 80vh;
        }

        /* --- Video Player Section --- */
        .video-section {
            background-color: var(--bg-card);
            border-radius: 12px;
            overflow: hidden;
            display: flex;
            flex-direction: column;
        }

        .video-container {
            width: 100%;
            aspect-ratio: 16/9;
            background: linear-gradient(rgba(0,0,0,0.4), rgba(0,0,0,0.8)), url('https://images.unsplash.com/photo-1540747913346-19e32dc3e97e?ixlib=rb-4.0.3&auto=format&fit=crop&w=1000&q=80') center/cover;
            position: relative;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .live-badge {
            position: absolute;
            top: 15px;
            left: 15px;
            background-color: var(--danger);
            color: white;
            padding: 4px 10px;
            border-radius: 5px;
            font-size: 0.8rem;
            font-weight: bold;
            display: flex;
            align-items: center;
            gap: 5px;
        }

        .live-badge i { font-size: 0.6rem; animation: blink 1s infinite; }

        @keyframes blink { 50% { opacity: 0; } }

        .play-btn {
            font-size: 4rem;
            color: rgba(255, 255, 255, 0.8);
            cursor: pointer;
            transition: transform 0.3s, color 0.3s;
        }

        .play-btn:hover {
            transform: scale(1.1);
            color: var(--accent);
        }

        .match-info-bar {
            padding: 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-top: 1px solid #333;
        }

        .teams h2 { font-size: 1.5rem; margin-bottom: 5px; }
        .tournament-name { color: var(--text-muted); font-size: 0.9rem; }
        
        .current-score { text-align: right; }
        .current-score h3 { font-size: 1.8rem; color: var(--accent); }
        .current-score p { color: var(--text-muted); font-size: 0.9rem; }

        /* --- Live Chat Section --- */
        .chat-section {
            background-color: var(--bg-card);
            border-radius: 12px;
            display: flex;
            flex-direction: column;
            height: 100%;
            border: 1px solid #333;
        }

        .chat-header {
            padding: 15px;
            border-bottom: 1px solid #333;
            font-weight: 600;
            display: flex;
            justify-content: space-between;
        }

        .chat-messages {
            flex-grow: 1;
            padding: 15px;
            overflow-y: auto;
            display: flex;
            flex-direction: column;
            gap: 10px;
            max-height: 500px;
        }

        .message { font-size: 0.9rem; line-height: 1.4; }
        .message .user { font-weight: bold; color: var(--accent); margin-right: 5px; }

        .chat-input {
            padding: 15px;
            border-top: 1px solid #333;
            display: flex;
            gap: 10px;
        }

        .chat-input input {
            flex-grow: 1;
            background-color: var(--bg-main);
            border: 1px solid #444;
            color: white;
            padding: 10px;
            border-radius: 20px;
            outline: none;
        }

        .chat-input button {
            background: none;
            border: none;
            color: var(--accent);
            font-size: 1.2rem;
            cursor: pointer;
        }

        /* --- Upcoming Matches --- */
        .upcoming-section {
            padding: 0 5% 40px;
        }

        .upcoming-section h3 { margin-bottom: 20px; font-size: 1.4rem; border-left: 4px solid var(--accent); padding-left: 10px; }

        .cards-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 20px;
        }

        .match-card {
            background-color: var(--bg-card);
            padding: 20px;
            border-radius: 10px;
            text-align: center;
            transition: transform 0.3s;
            cursor: pointer;
        }

        .match-card:hover { transform: translateY(-5px); background-color: var(--bg-hover); }
        .match-card .date { color: var(--accent); font-size: 0.8rem; font-weight: bold; margin-bottom: 10px; }
        .match-card .teams { font-size: 1.2rem; font-weight: 600; margin-bottom: 10px; }
        .match-card .series { color: var(--text-muted); font-size: 0.8rem; }

        /* --- Footer --- */
        footer {
            background-color: var(--bg-card);
            text-align: center;
            padding: 20px;
            color: var(--text-muted);
            border-top: 1px solid #333;
        }

        /* Responsive */
        @media (max-width: 992px) {
            .main-container { grid-template-columns: 1fr; }
            .chat-section { height: 400px; }
        }

        @media (max-width: 768px) {
            .nav-links { display: none; } /* Add hamburger menu in real app */
            .match-info-bar { flex-direction: column; text-align: center; gap: 15px; }
            .current-score { text-align: center; }
        }
    </style>
</head>
<body>

    <div class="score-ticker">
        <div class="ticker-content">
            <div class="ticker-item">IND vs AUS: <span>IND 245/4 (42.1 ov)</span></div>
            <div class="ticker-item">ENG vs SA: <span>ENG won by 45 runs</span></div>
            <div class="ticker-item">PAK vs NZ: <span>Match starts at 14:00 GMT</span></div>
            <div class="ticker-item">WI vs SL: <span>SL 120/8 (19.0 ov)</span></div>
            <div class="ticker-item">IND vs AUS: <span>IND 245/4 (42.1 ov)</span></div>
        </div>
    </div>

    <header>
        <div class="logo">
            <i class="fa-solid fa-cricket-bat-ball"></i> CricStream
        </div>
        <nav class="nav-links">
            <a href="#" class="active">Live</a>
            <a href="#">Highlights</a>
            <a href="#">Schedule</a>
            <a href="#">Series</a>
            <a href="#">News</a>
        </nav>
        <div class="user-actions">
            <button>Login / Sign Up</button>
        </div>
    </header>

    <div class="main-container">
        
        <main class="video-section">
            <div class="video-container">
                <div class="live-badge"><i class="fa-solid fa-circle"></i> LIVE</div>
                <i class="fa-solid fa-circle-play play-btn"></i>
                </div>
            
            <div class="match-info-bar">
                <div class="teams">
                    <h2>India vs Australia</h2>
                    <span class="tournament-name">World Test Championship Final - Day 3</span>
                </div>
                <div class="current-score">
                    <h3>IND 245/4</h3>
                    <p>Kohli 82* | Jadeja 34*</p>
                    <p style="color: var(--text-muted); font-size: 0.8rem;">CRR: 5.82</p>
                </div>
            </div>
        </main>

        <aside class="chat-section">
            <div class="chat-header">
                <span>Live Chat</span>
                <i class="fa-solid fa-users"></i>
            </div>
            <div class="chat-messages" id="chat-box">
                <div class="message"><span class="user">CricketFan99:</span> What a shot by Kohli! 🔥</div>
                <div class="message"><span class="user">AussieRules:</span> Need a wicket right now. Come on Starc!</div>
                <div class="message"><span class="user">Rahul_D:</span> Pitch is looking very flat today.</div>
                <div class="message"><span class="user">SportsGeek:</span> Partnership is looking dangerous. 100 up!</div>
            </div>
            <div class="chat-input">
                <input type="text" id="chat-input-field" placeholder="Say something...">
                <button onclick="sendMessage()"><i class="fa-solid fa-paper-plane"></i></button>
            </div>
        </aside>

    </div>

    <section class="upcoming-section">
        <h3>Upcoming Matches</h3>
        <div class="cards-grid">
            <div class="match-card">
                <div class="date">Tomorrow, 14:00 GMT</div>
                <div class="teams">PAK vs NZ</div>
                <div class="series">T20 International Series</div>
            </div>
            <div class="match-card">
                <div class="date">10 May, 09:30 GMT</div>
                <div class="teams">ENG vs SA</div>
                <div class="series">ODI World Cup Qualifier</div>
            </div>
            <div class="match-card">
                <div class="date">12 May, 18:00 GMT</div>
                <div class="teams">CSK vs MI</div>
                <div class="series">Premier League T20</div>
            </div>
            <div class="match-card">
                <div class="date">15 May, 10:00 GMT</div>
                <div class="teams">BAN vs AFG</div>
                <div class="series">Test Match - Day 1</div>
            </div>
        </div>
    </section>

    <footer>
        <p>&copy; 2026 CricStream Pro. All rights reserved.</p>
        <p style="font-size: 0.8rem; margin-top: 5px;">Disclaimer: This is a front-end template. Streaming functionality requires backend integration.</p>
    </footer>

    <script>
        // Simple script to handle mock chat messaging
        function sendMessage() {
            const inputField = document.getElementById('chat-input-field');
            const messageText = inputField.value.trim();
            
            if(messageText !== '') {
                const chatBox = document.getElementById('chat-box');
                
                // Create new message element
                const newMessage = document.createElement('div');
                newMessage.classList.add('message');
                newMessage.innerHTML = `<span class="user">You:</span> ${messageText}`;
                
                // Append and scroll to bottom
                chatBox.appendChild(newMessage);
                chatBox.scrollTop = chatBox.scrollHeight;
                
                // Clear input
                inputField.value = '';
            }
        }

        // Allow pressing Enter to send message
        document.getElementById('chat-input-field').addEventListener('keypress', function (e) {
            if (e.key === 'Enter') {
                sendMessage();
            }
        });
    </script>
</body>
</html>
